// Voxel sky dome -- WEBGL1 / GLSL100 twin of SkyMaterial.vert.glsl (same sky-cube trick: only the
// model's linear part is applied, the camera position is added, the depth is pinned just below
// the far plane so the sky never clips and every terrain pixel wins the depth test). WebGL1 binds
// attributes/uniforms by name, so this declares the engine-provided `u_vp`/`u_model`/`u_viewPos`.
attribute vec3 a_position;

uniform mat4 u_vp;
uniform mat4 u_model;
uniform vec3 u_viewPos;

varying vec3 v_dir;

void main() {
  v_dir = a_position;
  vec4 clip = u_vp * (u_model * vec4(a_position, 0.0) + vec4(u_viewPos, 1.0));
  gl_Position = vec4(clip.xy, clip.w * 0.99999, clip.w);
}
