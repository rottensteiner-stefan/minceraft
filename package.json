{
  "name": "minceraft",
  "private": true,
  "version": "0.1.1",
  "description": "Minceraft — chunk-streamed voxel sandbox. Standalone project; it consumes Small World Machine as versioned packages (pinned release URLs).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=8",
    "test:watch": "vitest",
    "check:voxel-m7": "node scripts/check-voxel-m7.mjs",
    "check:voxel-webgl1": "node scripts/check-voxel-webgl1.mjs",
    "kill:vite": "node .agents/skills/reset-vite/reset-vite.mjs"
  },
  "dependencies": {
    "@small-world-machine/engine": "https://github.com/rottensteiner-stefan/small-world-machine/releases/download/packages-0.129.2/small-world-machine-engine-0.129.2.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "jsdom": "^31.0.1",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
