{
  "name": "minceraft",
  "private": true,
  "version": "0.1.0",
  "description": "Minceraft — chunk-streamed voxel sandbox. Standalone project; it consumes Small World Machine as versioned packages (pinned release URLs).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=8",
    "test:watch": "vitest",
    "check:voxel-m7": "node scripts/check-voxel-m7.mjs",
    "check:voxel-webgl1": "node scripts/check-voxel-webgl1.mjs",
    "kill:vite": "node .agents/skills/reset-vite/reset-vite.mjs"
  },
  "dependencies": {
    "@small-world-machine/engine": "https://github.com/rottensteiner-stefan/small-world-machine/releases/download/packages-0.122.0/small-world-machine-engine-0.122.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@webgpu/types": "^0.1.71",
    "jsdom": "^30.0.1",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^5.0.5"
  }
}
